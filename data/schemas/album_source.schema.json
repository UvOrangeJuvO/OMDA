{
  "schema_name": "album_source",
  "schema_version": 1,
  "fields": {
    "source_id": {"type": "string", "required": true, "pattern": "^[a-z0-9-]+$"},
    "kind": {"type": "string", "required": true, "enum": ["album"]},
    "display_name": {"type": "string", "required": true, "min_length": 1},
    "license": {"type": "string", "required": true, "min_length": 1},
    "origin_url": {"type": "string", "required": true, "pattern": "^https?://"},
    "retrieved_at": {"type": "string", "required": true, "format": "iso8601-datetime"},
    "dataset_version": {"type": "string", "required": true, "min_length": 1},
    "schema_version": {"type": "string", "required": true, "min_length": 1},
    "data_scope": {"type": "string", "required": true, "min_length": 1},
    "records_file": {"type": "string", "required": true, "min_length": 1},
    "demo": {"type": "boolean", "required": true}
  }
}
