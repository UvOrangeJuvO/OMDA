{
  "schema_name": "candidate_batch",
  "schema_version": 2,
  "fields": {
    "schema_version": {"type": "string", "required": true, "enum": ["2"]},
    "query_policy_version": {"type": "string", "required": true, "min_length": 1},
    "genre_id": {"type": "string", "required": true, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "digest": {"type": "string", "required": true, "pattern": "^[0-9a-f]{64}$"},
    "source": {"type": "object", "required": true, "fields": {
      "source_id": {"type": "string", "required": true, "min_length": 1},
      "kind": {"type": "string", "required": true, "enum": ["album"]},
      "display_name": {"type": "string", "required": true, "min_length": 1},
      "license": {"type": "string", "required": true, "min_length": 1},
      "origin_url": {"type": "string", "required": true, "pattern": "^https?://"},
      "retrieved_at": {"type": "string", "required": true, "format": "iso8601-datetime"},
      "dataset_version": {"type": "string", "required": true, "min_length": 1},
      "schema_version": {"type": "string", "required": true, "min_length": 1},
      "data_scope": {"type": "string", "required": true, "min_length": 1},
      "records_file": {"type": "string", "required": true, "min_length": 1},
      "demo": {"type": "boolean", "required": true},
      "data_derivation": {"type": "string", "required": true, "enum": ["independently_curated", "derived_from_upstream"]},
      "upstream_license": {"type": "string", "required": true, "min_length": 1},
      "license_core_facts": {"type": "string", "required": true, "min_length": 1},
      "license_supplementary_used": {"type": "string", "required": true, "min_length": 1},
      "license_service_terms": {"type": "string", "required": true, "min_length": 1},
      "license_derived_package": {"type": "string", "required": true, "min_length": 1}
    }},
    "candidates": {
      "type": "array",
      "required": true,
      "items": {"type": "object", "fields": {
        "album_id": {"type": "string", "required": true, "min_length": 1},
        "genre_id": {"type": "string", "required": true, "min_length": 1},
        "title": {"type": "string", "required": true, "min_length": 1},
        "artist": {"type": "string", "required": true, "min_length": 1},
        "year": {"type": "integer", "required": false},
        "mbid": {"type": "string", "required": false},
        "release_type": {"type": "string", "required": true, "enum": ["album"]},
        "score": {"type": "number", "required": false}
      }}
    }
  }
}
