{
  "schema_name": "album_candidate",
  "schema_version": 1,
  "fields": {
    "album_id": {"type": "string", "required": true, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "required": true, "min_length": 1},
    "artist": {"type": "string", "required": true, "min_length": 1},
    "year": {"type": "integer", "required": false},
    "mbid": {
      "type": "string",
      "required": false,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "release_type": {"type": "string", "required": true, "enum": ["album"]},
    "score": {"type": "number", "required": false},
    "source": {"type": "string", "required": true, "min_length": 1}
  }
}
