    "run_id": {"type": "string", "required": true, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "genre_id": {"type": "string", "required": true, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "committed_at": {"type": "string", "required": true, "format": "iso8601-datetime"}
  }
}
