{
  "schema_name": "album_history",
  "schema_version": 1,
  "fields": {
    "album_id": {"type": "string", "required": true, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "canonical_id": {"type": "string", "required": false, "min_length": 1},
    "canonical_source": {"type": "string", "required": false, "enum": ["musicbrainz", "none"]},
    "identity_confidence": {"type": "string", "required": false, "enum": ["exact", "normalized", "ambiguous"]},
    "run_id": {"type": "string", "required": true, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "recommended_at": {"type": "string", "required": true, "format": "iso8601-datetime"}
  }
}
