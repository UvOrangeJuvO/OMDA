{
  "schema_name": "plan",
  "schema_version": 1,
  "fields": {
    "plan_id": {"type": "string", "required": true, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "run_id": {"type": "string", "required": true, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "created_at": {"type": "string", "required": true, "format": "iso8601-datetime"},
    "seed": {"type": "string", "required": true, "min_length": 1},
    "input_data_version": {"type": "string", "required": true, "min_length": 1},
    "genres": {
      "type": "array",
      "required": true,
      "items": {
        "type": "object",
        "fields": {
          "genre_id": {"type": "string", "required": true},
          "pick_index": {"type": "integer", "required": true, "min": 1},
          "family": {"type": "string", "required": true}
        }
      }
    },
    "albums": {
      "type": "array",
      "required": true,
      "items": {
        "type": "object",
        "fields": {
          "album_id": {"type": "string", "required": true},
          "genre_id": {"type": "string", "required": true},
          "title": {"type": "string", "required": true},
          "artist": {"type": "string", "required": true},
          "year": {"type": "integer", "required": false}
        }
      }
    }
  }
}
