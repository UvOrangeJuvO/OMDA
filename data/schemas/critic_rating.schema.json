{
  "schema_name": "critic_rating",
  "schema_version": 1,
  "fields": {
    "source_id": {"type": "string", "required": true, "pattern": "^[a-z0-9-]+$"},
    "album_id": {"type": "string", "required": true, "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "rating": {"type": "number", "required": true},
    "rating_max": {"type": "number", "required": false},
    "review_url": {"type": "string", "required": false, "pattern": "^https?://"}
  }
}
